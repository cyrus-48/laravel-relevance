{
    "name": "cyrus-48/laravel-relevance",
    "description": "A Multipurpose Search & Recommendation Toolkit for Laravel",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Cyrus Mwendwa",
            "email": "cyrusmwendwa370@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/pipeline": "^11.0|^12.0|^13.0",
        "illuminate/events": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "orchestra/testbench": "^9.0|^10.0",
        "phpstan/phpstan": "^1.11|^2.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Relevance\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Relevance\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Relevance\\RelevanceServiceProvider"
            ],
            "aliases": {
                "Relevance": "Relevance\\Facades\\Relevance"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
